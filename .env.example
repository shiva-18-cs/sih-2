# Database Configuration
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/cmpdi_intelligence

# JWT Authentication
SECRET_KEY=super-secret-cmpdi-jwt-key-for-hackathon-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Storage
STORAGE_DIR=./storage/documents
